+    /// # #[tokio::main(flavor = "current_thread")]
+    /// # async fn main() {
+    /// let lock = Arc::new(RwLock::new(1));
+    ///
+    /// let guard = lock.clone().read_owned().await;
+    /// let mut guard = OwnedRwLockReadGuard::upgrade(guard)
