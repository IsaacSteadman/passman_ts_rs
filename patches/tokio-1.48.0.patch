+    /// Upgrades a read guard of this `RwLock` to exclusive write access,
+    /// without releasing its read access in the meantime.
+    ///
+    /// The calling task will yield until every other reader has released its
+    /// read access. The upgrade is served ahead of any task already waiting
+    /// for the lock, including writers, so nothing else can acquire the lock
+    /// between the read guard and the returned write guard.
+    ///
+    /// Only one upgrade can be in progress at a time: two upgrading tasks
+    /// would each wait for the other's read access forever. If another
+    /// upgrade of this lock is in progress, this returns the read guard
+    /// unchanged as `Err` without waiting. The caller should then drop it
+    /// (allowing the other upgrade to finish) before trying again.
+    ///
+    /// The upgrade will never complete if the calling task holds any other
+    /// read guard of this lock.
+    ///
+    /// # Cancel safety
+    ///
+    /// If the returned future is dropped before completing, the read guard is
+    /// dropped as well, releasing its read access.
+    ///
+    /// # Panics
+    ///
+    /// Panics if `guard` was not acquired from this `RwLock`.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use tokio::sync::RwLock;
+    ///
+    /// # #[tokio::main(flavor = "current_thread")]
+    /// # async fn main() {
+    /// let lock = RwLock::new(Vec::new());
+    ///
+    /// let guard = lock.read().await;
+    /// if guard.is_empty() {
+    ///     let mut guard = lock.upgrade(guard).await.expect("no other upgrade in progress");
+    ///     // No other task can have modified the data since it was read.
+    ///     guard.push(1);
+    /// }
+    /// # }
+    /// ```
+    pub async fn upgrade<'a>(
+        &'a self,
+        guard: RwLockReadGuard<'a, T>,
+    ) -> Result<RwLockWriteGuard<'a, T>, RwLockReadGuard<'a, T>> {
+        assert!(
+            ptr::eq(guard.s, &self.s),
+            "RwLock::upgrade called with a read guard of a different RwLock"
+        );
+        let Some(_upgrading) = self.start_upgrade() else {
+            return Err(guard);
+        };
