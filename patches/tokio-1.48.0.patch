+// Readers queued after a writer stay queued behind the upgrade and the writer.
+#[test]
+fn upgrade_ahead_of_queued_readers() {
+    let rwlock = RwLock::new(1);
+    let g1 = assert_ready!(spawn(rwlock.read()).poll());
+    let g2 = assert_ready!(spawn(rwlock.read()).poll());
+
+    let mut write = spawn(rwlock.write());
+    assert_pending!(write.poll());
+    let mut read = spawn(rwlock.read());
+    assert_pending!(read.poll());
+
+    let mut upgrade = spawn(rwlock.upgrade(g1));
+    assert_pending!(upgrade.poll());
+    drop(g2);
+    let w = assert_ready!(upgrade.poll()).unwrap();
+    assert_pending!(write.poll());
+    assert_pending!(read.poll());
+
+    drop(w);
+    let w = assert_ready!(write.poll());
+    assert_pending!(read.poll());
+    drop(w);
