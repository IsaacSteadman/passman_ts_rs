+// Two concurrent upgrades would wait for each other's read permit, so the
+// second is refused immediately.
+#[test]
+fn concurrent_upgrade_refused() {
+    let rwlock = RwLock::new(1);
+    let g1 = assert_ready!(spawn(rwlock.read()).poll());
+    let g2 = assert_ready!(spawn(rwlock.read()).poll());
+
+    let mut upgrade1 = spawn(rwlock.upgrade(g1));
+    assert_pending!(upgrade1.poll());
+
+    let g2 = assert_ready!(spawn(rwlock.upgrade(g2)).poll()).unwrap_err();
+    assert_pending!(upgrade1.poll());
+    drop(g2);
+    let w = assert_ready!(upgrade1.poll()).unwrap();
+    drop(w);
+
+    // once the first upgrade is done, upgrading is possible again
+    let g = assert_ready!(spawn(rwlock.read()).poll());
+    let _w = assert_ready!(spawn(rwlock.upgrade(g)).poll()).unwrap();
+}
