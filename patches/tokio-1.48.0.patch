+
+// An upgrade racing with a writer that queues behind the upgrading read
+// permit: both must complete, and the upgrade must see no intervening write.
+#[test]
+fn upgrade_with_concurrent_writer() {
+    loom::model(|| {
+        let rwlock = Arc::new(RwLock::<u32>::new(0));
+
+        let rwclone = rwlock.clone();
+        let t1 = thread::spawn(move || {
+            block_on(async {
+                let guard = rwclone.read().await;
+                let seen = *guard;
+                let mut guard = rwclone
+                    .upgrade(guard)
+                    .await
+                    .expect("only one upgrader, so the upgrade cannot be refused");
+                assert_eq!(seen, *guard);
+                *guard += 1;
+            });
+        });
+
+        let rwclone = rwlock.clone();
+        let t2 = thread::spawn(move || {
+            block_on(async {
+                *rwclone.write().await += 10;
+            });
+        });
+
+        t1.join().expect("upgrading thread should not panic");
+        t2.join().expect("writing thread should not panic");
+        assert_eq!(11, *block_on(rwlock.read()));
+    });
+}
+
+// An owned upgrade racing with a plain reader and a writer.
+#[test]
+fn upgrade_owned_with_reader_and_writer() {
+    loom::model(|| {
+        let rwlock = Arc::new(RwLock::<u32>::new(0));
+
+        let rwclone = rwlock.clone();
+        let t1 = thread::spawn(move || {
+            block_on(async {
+                let guard = rwclone.read_owned().await;
+                let mut guard = OwnedRwLockReadGuard::upgrade(guard)
+                    .await
+                    .expect("only one upgrader, so the upgrade cannot be refused");
+                *guard += 1;
+            });
+        });
+
+        let rwclone = rwlock.clone();
+        let t2 = thread::spawn(move || {
+            block_on(async {
+                *rwclone.write().await += 10;
+            });
+        });
+
+        let value = *block_on(rwlock.read());
+        assert!([0, 1, 10, 11].contains(&value));
+
+        t1.join().expect("upgrading thread should not panic");
+        t2.join().expect("writing thread should not panic");
+        assert_eq!(11, *block_on(rwlock.read()));
+    });
+}
+
+// Two tasks upgrading at once: one may be refused, in which case it drops its
+// read guard and retries. Both increments must land.
+#[test]
+fn concurrent_upgrades() {
+    loom::model(|| {
+        let rwlock = Arc::new(RwLock::<u32>::new(0));
+
+        let upgrader = |rwlock: Arc<RwLock<u32>>| {
+            thread::spawn(move || {
+                block_on(async {
+                    loop {
+                        let guard = rwlock.read().await;
+                        match rwlock.upgrade(guard).await {
+                            Ok(mut guard) => {
+                                *guard += 1;
+                                break;
+                            }
+                            Err(guard) => {
+                                drop(guard);
+                                thread::yield_now();
+                            }
+                        }
+                    }
+                });
+            })
+        };
+        let t1 = upgrader(rwlock.clone());
+        let t2 = upgrader(rwlock.clone());
+
+        t1.join().expect("thread 1 should not panic");
+        t2.join().expect("thread 2 should not panic");
+        assert_eq!(2, *block_on(rwlock.read()));
+    });
+}
