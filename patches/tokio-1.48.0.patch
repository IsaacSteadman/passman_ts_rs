+#[test]
+fn upgrade_owned_mapped() {
+    let rwlock = Arc::new(RwLock::new((1, 2)));
+    let g1 = assert_ready!(spawn(rwlock.clone().read_owned()).poll());
+    let g1 = OwnedRwLockReadGuard::map(g1, |v| &v.1);
+    let g2 = assert_ready!(spawn(rwlock.clone().read_owned()).poll());
+
+    let mut write = spawn(rwlock.clone().write_owned());
+    assert_pending!(write.poll());
+
+    let mut upgrade = spawn(OwnedRwLockReadGuard::upgrade(g1));
+    assert_pending!(upgrade.poll());
+    let g2 = assert_ready!(spawn(OwnedRwLockReadGuard::upgrade(g2)).poll()).unwrap_err();
+    drop(g2);
+
+    let mut w = assert_ready!(upgrade.poll()).unwrap();
+    w.0 += 10;
+    drop(w);
+    let w = assert_ready!(write.poll());
+    assert_eq!(*w, (11, 2));
+    drop(w);
+    drop(write);
+    drop(upgrade);
+    assert_eq!(Arc::strong_count(&rwlock), 1);
