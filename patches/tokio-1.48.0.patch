+#[test]
+fn upgrade_uncontested() {
+    let rwlock = RwLock::new(1);
+    let g = assert_ready!(spawn(rwlock.read()).poll());
+    let mut w = assert_ready!(spawn(rwlock.upgrade(g)).poll()).unwrap();
+    *w += 1;
+    // the write guard holds every permit
+    assert!(rwlock.try_read().is_err());
+    drop(w);
+    assert_eq!(*rwlock.try_read().unwrap(), 2);
+
+    // a lock with a single reader needs no further permits to upgrade
+    let rwlock = RwLock::with_max_readers(1, 1);
+    let g = assert_ready!(spawn(rwlock.read()).poll());
+    let w = assert_ready!(spawn(rwlock.upgrade(g)).poll()).unwrap();
+    drop(w);
+    assert!(rwlock.try_write().is_ok());
+}
+
+#[test]
+fn upgrade_waits_for_other_readers() {
+    let rwlock = RwLock::new(1);
+    let g1 = assert_ready!(spawn(rwlock.read()).poll());
+    let g2 = assert_ready!(spawn(rwlock.read()).poll());
+
+    let mut upgrade = spawn(rwlock.upgrade(g1));
+    assert_pending!(upgrade.poll());
+    drop(g2);
+    assert!(upgrade.is_woken());
+    let _w = assert_ready!(upgrade.poll()).unwrap();
+}
+
+// An upgrade must not queue behind a writer that is waiting for the upgrading
+// guard's own read permit.
+#[test]
+fn upgrade_ahead_of_queued_writer() {
+    let rwlock = RwLock::new(1);
+    let g1 = assert_ready!(spawn(rwlock.read()).poll());
+    let g2 = assert_ready!(spawn(rwlock.read()).poll());
+
+    let mut write = spawn(rwlock.write());
+    assert_pending!(write.poll());
+
+    let mut upgrade = spawn(rwlock.upgrade(g1));
+    assert_pending!(upgrade.poll());
+
+    drop(g2);
+    assert!(upgrade.is_woken());
+    let mut w = assert_ready!(upgrade.poll()).unwrap();
+    assert_pending!(write.poll());
+    *w += 1;
+    drop(w);
+
+    assert!(write.is_woken());
+    let mut w = assert_ready!(write.poll());
+    assert_eq!(*w, 2);
+    *w += 1;
+    drop(w);
+    assert_eq!(*rwlock.try_read().unwrap(), 3);
+}
