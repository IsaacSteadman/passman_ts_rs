<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only certificate authorities that come with Android: not
     ones the user (or a device management profile) installed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
