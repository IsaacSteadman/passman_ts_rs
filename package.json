{
  "name": "passman_ts_rs",
  "version": "1.0.0",
  "description": "Password manager in Typescript frontend and Rust backend",
  "author": "Isaac Steadman",
  "license": "MIT",
  "dependencies": {
    "jsqr": "^1.4.0",
    "less": "^4.4.2",
    "parcel": "^2.16.3",
    "passman_crypto": "file:passman_crypto/pkg",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.9.3"
  },
  "targets": {
    "default": {
      "context": "browser"
    }
  },
  "scripts": {
    "build:wasm": "wasm-pack build passman_crypto --target web --out-dir pkg",
    "prebuild": "npm run build:wasm",
    "prestart": "npm run build:wasm",
    "build": "npx parcel build frontend/index.html",
    "build:extension": "npm run build:wasm && node scripts/build-extension.mjs",
    "build:android": "npm run build:wasm && node scripts/build-android.mjs",
    "start": "npx parcel serve frontend/index.html",
    "test": "playwright test"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.3",
    "@parcel/service-worker": "^2.16.4",
    "@parcel/transformer-less": "^2.16.3",
    "@parcel/transformer-webmanifest": "^2.16.3",
    "@playwright/test": "^1.50.0",
    "@types/chrome": "^0.3.6"
  }
}
